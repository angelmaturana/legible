[
  {
    "@type": "Organization",
    "@id": "{{site_url}}/#business",
    "name": "{{site_name}}",
    "description": "{{site_description}}",
    "url": "{{site_url}}",
    "email": "{{contact_email}}",
    "logo": "{{site_url}}/images/logo.svg",
    "image": "{{site_url}}/images/og-image.png",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "email": "{{contact_email}}",
      "availableLanguage": "{{lang}}",
      "telephone": "{{phone_e164}}"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "{{city}}",
      "addressRegion": "{{region}}",
      "addressCountry": "ES"
    },
    "areaServed": [
      {
        "@type": "City",
        "name": "Madrid"
      },
      {
        "@type": "City",
        "name": "Getafe"
      },
      {
        "@type": "City",
        "name": "Alcobendas"
      },
      {
        "@type": "City",
        "name": "Las Rozas"
      }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "{{site_name}} offers",
      "itemListElement": [
        {
          "@type": "Offer",
          "name": "Free Consultation",
          "url": "{{site_url}}/contact/",
          "priceCurrency": "EUR",
          "price": "0",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "0",
            "priceCurrency": "EUR"
          },
          "itemOffered": {
            "@type": "Service",
            "name": "Free Consultation",
            "serviceType": "Initial consultation",
            "url": "{{site_url}}/contact/"
          }
        }
      ]
    },
    "sameAs": []
  },
  {
    "@type": "WebSite",
    "@id": "{{site_url}}/#website",
    "url": "{{site_url}}/",
    "name": "{{site_name}}",
    "inLanguage": "{{in_language}}",
    "publisher": {
      "@id": "{{site_url}}/#business"
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "{{site_url}}/blog/?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@type": "Blog",
    "@id": "{{site_url}}/#blog",
    "name": "{{site_name}}",
    "description": "Technology blog featuring reviews, tutorials, industry news, and opinion pieces",
    "url": "{{site_url}}/blog/",
    "inLanguage": "{{in_language}}",
    "publisher": {
      "@id": "{{site_url}}/#business"
    },
    "blogPosts": {
      "@type": "ItemList",
      "itemListElement": []
    }
  },
  {
    "@type": "Person",
    "@id": "{{site_url}}/#author",
    "name": "TechFlow Author",
    "email": "{{contact_email}}",
    "url": "{{site_url}}/about/",
    "affiliation": {
      "@id": "{{site_url}}/#business"
    }
  }
]